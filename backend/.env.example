PROJECT_NAME="Brightloop Subscription Management"
ENVIRONMENT="development"
DEBUG=true

# MongoDB connection (requires replica set for ACID transactions)
MONGODB_URL="mongodb://127.0.0.1:27018/brightloop?replicaSet=rs0&directConnection=true"
DATABASE_NAME="brightloop"

# Security
JWT_SECRET="brightloop-super-secure-secret-key-32-chars-minimum"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# Billing
AUTO_CONFIRM_INVOICES=false

# SMTP
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAILS_FROM_EMAIL="noreply@brightloop.local"
